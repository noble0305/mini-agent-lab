# 任意 OpenAI 兼容接口均可（DeepSeek / OpenAI / Gemini 兼容端点 / OpenRouter / 本地代理）
OPENAI_API_KEY=your_api_key_here

# 示例 1：DeepSeek
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 示例 2：OpenAI 官方（留空 BASE_URL 即可）
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# 示例 3：Google Gemini (OpenAI 兼容接口)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# --- S02 双模型路由可选配置（不填则默认复用上方 OPENAI_MODEL / BASE_URL / KEY） ---
# PLANNER_MODEL=deepseek-reasoner
# EXECUTOR_MODEL=deepseek-chat
# 跨厂商路由时可单独指定 Executor 凭证：
# EXECUTOR_BASE_URL=
# EXECUTOR_API_KEY=

# --- S03 上下文压缩可选配置 ---
# 触发自动滚动摘要压缩的估算 Token 阈值（调小如 300 更容易观察压缩效果）
# S03_TOKEN_BUDGET=1200

# --- S05 HTTP 服务（未配置 OPENAI_API_KEY 时自动进入 mock 模式） ---
# 强制 mock（1）或强制真实模型（0，需同时提供 key）
# MOCK_LLM=1
# HOST=127.0.0.1
# PORT=8080
# LOG_DIR=logs
# 工具沙箱根目录（默认当前目录）
# WORKSPACE=.
# ReAct 最大步数熔断
# MAX_STEPS=6
